{
  "name": "resume-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc -b && vite build && node scripts/generate-sw.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-assets.mjs",
    "check": "tsc -b",
    "format": "prettier --write src tests scripts docs README.md vite.config.ts tsconfig.json package.json .github"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.8",
    "@react-pdf/renderer": "^4.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "dexie": "^4.0.11",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
